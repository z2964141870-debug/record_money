{
  "name": "record-money",
  "version": "0.8.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node build/start.js",
    "setup": "tsx tools/setup.ts",
    "connections": "tsx tools/connections.ts",
    "release": "tsx tools/release.ts",
    "package:mac": "tsx tools/package-mac.ts",
    "package:windows": "tsx tools/package-windows.ts",
    "smoke:windows": "tsx tools/windows-smoke.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "service:install": "tsx tools/service.ts install",
    "service:stop": "tsx tools/service.ts stop",
    "service:uninstall": "tsx tools/service.ts uninstall",
    "backup": "tsx tools/backup.ts",
    "restore": "tsx tools/backup.ts restore"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@larksuiteoapi/node-sdk": "1.74.0",
    "@napi-rs/canvas": "^1.0.10",
    "better-sqlite3": "13.0.3",
    "dingtalk-stream": "2.1.6-beta.1",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "openai": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
